# Telegram-бот КАРУСЕЛЬКА (отдельный от Posts EMDR)
# Скопируйте: cp telegram.env.example telegram.env.local
# Создайте бота: @BotFather → /newbot

# Токен бота (intake + уведомления)
TELEGRAM_BOT_TOKEN=

# Chat ID, куда ты кидаешь ссылки на конкурентов (твой личный chat или приватная группа)
TELEGRAM_INTAKE_CHAT_ID=

# Куда слать уведомления после публикации:
# - Instagram: «добавь музыку в IG»
# - TikTok (Zernio): «карусель в TikTok — смени музыку вручную» (auto_add_music только рекомендует трек)
# Обычно тот же chat_id, что и intake
TELEGRAM_NOTIFY_CHAT_ID=

# Опционально: username бота для справки в логах
TELEGRAM_BOT_USERNAME=
