# Cloud worker (не коммитить)
# cp cloud-worker.env.example cloud-worker.env.local

# GCP (тот же проект, что ai-carousel-renderer)
PROJECT_ID=

# Случайный ключ для Cloud Scheduler → X-Worker-Key
WORKER_API_KEY=

# Ключ Cloud Run renderer (модуль 7 в Make / generate-carousel)
CLOUD_RUN_API_KEY=

SERVICE_NAME=karuselka-publish-worker
REGION=europe-west1
