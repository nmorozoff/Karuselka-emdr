# Разбор ссылок конкурентов (как ai-carousel-natasha)
# Скопируйте: cp analyze.env.example analyze.env.local

# --- Instagram: скачивание медиа + caption ---
# https://console.apify.com/
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-api-scraper
APIFY_TIMEOUT_SECONDS=60

# --- Vision + структура (дешевле коллажного GPT-4o) ---
# https://platform.moonshot.ai/
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
ANALYZE_MAX_TOKENS=8192

# --- Речь из видео (Whisper, не Kimi) ---
# https://console.groq.com/
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIBE_LANGUAGE=ru
GROQ_TRANSCRIBE_TIMEOUT_SECONDS=180

# Кадры для OCR немых рилсов (заголовок на видео)
MAX_VIDEO_FRAMES=8
