# Runware — генерация слайдов карусели (НЕ коммитить)
# Скопируйте: cp runware.env.example runware.env.local
# Dashboard: https://runware.ai/

RUNWARE_API_KEY=

# Модель (как в ai-carousel-natasha)
RUNWARE_GPT_IMAGE_MODEL=openai:gpt-image@2
RUNWARE_API_URL=https://api.runware.ai/v1

# Качество: medium (не low)
RUNWARE_IMAGE_QUALITY=medium

# Слайд Instagram 4:5 (1080×1350)
RUNWARE_GPT_IMAGE_WIDTH=1080
RUNWARE_GPT_IMAGE_HEIGHT=1350

# Таймаут запроса (сек)
REQUEST_TIMEOUT_SECONDS=180
